{
  "name": "timezest",
  "version": "3.0.2",
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "format": "prettier --config .prettierrc --write src vitest.config.mts tsconfig.json tsconfig.build.json package.json",
    "lint": "prettier --config .prettierrc --check src vitest.config.mts tsconfig.json tsconfig.build.json package.json",
    "lint:fix": "eslint src --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "description": "",
  "dependencies": {
    "axios": "^1.13.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "prettier": "^3.5.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pncit/timezest.git"
  }
}
